# Скопируйте в .env и при необходимости поправьте. Реальный .env не коммитим.
POSTGRES_DB=wms
POSTGRES_USER=wms
POSTGRES_PASSWORD=wms

# Для запуска backend локально (вне Docker)
DATABASE_URL=postgresql+psycopg://wms:wms@localhost:5432/wms
TEST_DATABASE_URL=postgresql+psycopg://wms:wms@localhost:5432/wms_test

# Заглушка, не реальный секрет. В своём .env задайте длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
